# Development only. Generate your own key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=local-development-change-me
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq/
# JSON array of exact host names (no scheme/path). Empty array disables all webhook destinations.
WEBHOOK_ALLOWED_HOSTS=[]
# Never enable for a public/production deployment.
WEBHOOK_ALLOW_HTTP=false
