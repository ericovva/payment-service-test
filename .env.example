# Development only. Generate your own key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=local-development-change-me
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq/
# JSON array of exact host names (no scheme/path). Empty array disables all webhook destinations.
WEBHOOK_ALLOWED_HOSTS=[]
# Never enable for a public/production deployment.
WEBHOOK_ALLOW_HTTP=false

# Each process owns this bounded pool; budget across ALL replicas.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=2
# Assignment default: one processing slot. Scale explicitly after measuring.
WORKER_CONCURRENCY=1
PROCESSING_LEASE_SECONDS=45
GATEWAY_TIMEOUT=10
WEBHOOK_TIMEOUT=10
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISH_CONCURRENCY=10
OUTBOX_LEASE_SECONDS=30
# Cached SOFT global backlog threshold; stale samples reject new work.
API_MAX_PENDING_PAYMENTS=100000
BACKLOG_REFRESH_SECONDS=1
API_MAX_INFLIGHT=256
API_MAX_BODY_BYTES=65536
API_BODY_TIMEOUT=10
